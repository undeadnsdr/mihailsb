# Заголовки безопасности и кеширование для шаред-хостинга (Apache).
# В режиме статического экспорта Next не применяет headers() из next.config.mjs,
# поэтому те же правила дублируются здесь и уезжают вместе со статикой.

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=63072000"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # X-Frame-Options не ставим: ссылку разворачивают в превью мессенджеров
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-inline' https://mc.yandex.ru; connect-src 'self' https://mc.yandex.ru; frame-src https://mc.yandex.ru; form-action 'self'; base-uri 'self'; object-src 'none'"

  # Service worker обязан отдаваться свежим, иначе обновление сайта не дойдёт
  <FilesMatch "sw\.js$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Хешированные ассеты Next можно кешировать навсегда
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|woff2|js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

# HTTPS и без-www как единственная версия
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

ErrorDocument 404 /404.html
